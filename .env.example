# Copy to .env.local (local) and add the same variables in Vercel → Settings → Environment Variables.

# Public site URL (used for SEO, sitemap, sharing)
NEXT_PUBLIC_SITE_URL=https://prometeofinedining.it

# ---- Supabase (Project Settings → API Keys) ----
# Without these three the site runs in LOCAL DEMO mode (data/local-db.json), development only.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---- Local mode only: admin password (default in development: "prometeo") ----
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=a-long-random-string

# ---- Optional: e-mail on every new booking (https://resend.com) ----
# RESEND_API_KEY=re_xxx
# BOOKING_NOTIFY_EMAIL=info@ristorante.it
# BOOKING_FROM_EMAIL=Prometeo <prenotazioni@tuodominio.it>

# ---- Push notifications of the staff app "Prometeo Gestione" ----
# Generate once with:  npx web-push generate-vapid-keys
# Without them the app works, but phones and computers get no notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contact sent to the push services (Google, Apple, Mozilla): the restaurant's e-mail
VAPID_SUBJECT=mailto:prenotazioni@tuodominio.it

# ---- Automatic WhatsApp messages to guests (YCloud, WhatsApp Business App coexistence) ----
# See README → "Messaggi WhatsApp automatici". Without these the app opens WhatsApp with the message ready.
# YCloud → Developers → API Keys
YCLOUD_API_KEY=
# the restaurant's WhatsApp number connected in YCloud
YCLOUD_WHATSAPP_FROM=+39
# printed by `npm run whatsapp -- webhook` (YCloud → Developers → Webhooks)
YCLOUD_WEBHOOK_SECRET=

# ---- Vercel Cron that keeps the free Supabase project awake (vercel.json → /api/cron/keepalive) ----
# Any long random string (openssl rand -hex 32): Vercel sends it to the cron, other callers are refused. Vercel only.
CRON_SECRET=
